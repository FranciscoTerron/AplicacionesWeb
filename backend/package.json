{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently \"php artisan serve\" \"vite\"",
        "dev:php": "php artisan serve",
        "dev:vite": "vite",
        "build": "vite build",
        "start": "php artisan serve",
        "test": "php artisan test",
        "test:watch": "php artisan test --watch",
        "lint": "pint",
        "lint:fix": "pint --fix",
        "stan": "phpstan analyse app --level=5",
        "migrate": "php artisan migrate",
        "seed": "php artisan db:seed",
        "migrate:fresh": "php artisan migrate:fresh --seed"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
