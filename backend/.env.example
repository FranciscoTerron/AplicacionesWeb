APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=1.0.0

# Clave compartida que el frontend React envía en X-App-Key para usar la API.
# Si se deja vacía, la verificación NO se aplica (dev/tests). En producción
# setear un valor y replicarlo en el front (NEXT_PUBLIC_APP_KEY).
APP_PUBLIC_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=firestore
# FIRESTORE_PROJECT_ID=your-project-id
# FIRESTORE_KEY_FILE=path/to/firebase-service-account.json
# FIRESTORE_DATABASE_ID=(default)

# En Vercel usar FIRESTORE_CREDENTIALS_JSON (contenido completo del service account en una línea):
# FIRESTORE_PROJECT_ID=tu-project-id
# FIRESTORE_CREDENTIALS_JSON={"type":"service_account",...}
# CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://www.tu-dominio.com

# En Vercel (producción y preview) usar las siguientes en lugar de FIRESTORE_KEY_FILE:
# FIRESTORE_PROJECT_ID=ma-piscinas-19b81
# FIRESTORE_CREDENTIALS_JSON={"type":"service_account",...}   # contenido completo de firebase-service-account.json (Sensitive)
# Vercel es serverless: cachés y vistas compiladas tienen que ir a /tmp
# APP_CONFIG_CACHE=/tmp/config.php
# APP_EVENTS_CACHE=/tmp/events.php
# APP_PACKAGES_CACHE=/tmp/packages.php
# APP_ROUTES_CACHE=/tmp/routes.php
# APP_SERVICES_CACHE=/tmp/services.php
# VIEW_COMPILED_PATH=/tmp
# CACHE_DRIVER=array
# LOG_CHANNEL=stderr

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Cloudinary (image hosting + delivery).
# El upload preset debe crearse en Settings → Upload → Add upload preset con Signing Mode = Unsigned.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Google OAuth (Socialite). Crear credentials en https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   http://127.0.0.1:8000/auth/google/callback     (local)
#   https://app-web-xi-roan.vercel.app/auth/google/callback  (producción)
#   https://aplicaciones-web-ecommerce.vercel.app/auth/google/callback  (preview Vercel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# Coma-separado: emails que serán admin al loguear por Google por primera vez
GOOGLE_ADMIN_EMAILS=franciscoterrondg19@gmail.com
# Opcional: restringir a dominios (ej. "tudominio.com,otrodominio.com"). Vacío = cualquier email.
GOOGLE_ALLOWED_DOMAINS=

# ── Vercel / producción ─────────────────────────────────────────────────────
# Obtener de Vercel Dashboard → Settings → Environment Variables
# CORS_ALLOWED_ORIGINS=https://aplicaciones-web-ecommerce.vercel.app
# FIRESTORE_PROJECT_ID=ma-piscinas-19b81
# FIRESTORE_CREDENTIALS_JSON={"type":"service_account",...completo JSON en una línea...}

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# URL del frontend (back_urls del Checkout Pro). Local: http://localhost:3000
# Prod: https://aplicaciones-web-tienda-rho.vercel.app
FRONTEND_URL=http://localhost:3000

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
