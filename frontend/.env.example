# URL base de la API Laravel
# Dev:  http://localhost:8000/api/v1
# Prod: https://aplicaciones-web-one.vercel.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Clave compartida enviada en el header X-App-Key. Debe coincidir con
# APP_PUBLIC_KEY del backend. En dev puede quedar vacía (el back no la exige).
NEXT_PUBLIC_APP_KEY=
